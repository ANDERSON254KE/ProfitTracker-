{
  "$schema": "openapi.vercel.sh/vercel.json",
  "buildCommand": "python manage.py migrate --noinput",
  "functions": {
    "profit_tracker_pro/wsgi.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/profit_tracker_pro/wsgi.py"
    }
  ]
}
